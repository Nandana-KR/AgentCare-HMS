# Copy this file to .env for local development.
# Never commit real secrets or production credentials.

ENVIRONMENT=development

DATABASE_URL=postgresql://hospital_user:hospital_pass@localhost:5432/hospital_db

SECRET_KEY=replace-with-a-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

GROQ_API_KEY=replace-with-your-groq-key
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Hospital_Agentic_System

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://hospital-ms-nandana.vercel.app,https://agent-care-hms.vercel.app,https://agent-care-hms-nandana.vercel.app,https://agentcare-nandana.vercel.app
